{
  "name": "ams",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "bash scripts/smoke.sh",
    "test:responsive": "node e2e/responsive.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "analysis:eval-mapping": "node scripts/analysis-eval-mapping.mjs",
    "assistant:eval": "node scripts/assistant-eval.mjs",
    "test:routes":"vitest run apps/api/src/routes.test.ts",
    "db:test": "vitest run packages/db",
    "db:generate": "pnpm --filter @ams/db exec drizzle-kit generate",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
