# All configuration is environment-only (DEC-008). Copy to .env for docker compose.
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL 16+ (compose service "postgres")
POSTGRES_USER=ams
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ams
DATABASE_URL=postgres://ams:change-me@postgres:5432/ams

# Better Auth: random string, 32+ chars (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# S3-compatible storage (compose service "minio"; any S3 API works)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ams
S3_ACCESS_KEY_ID=amsminio
S3_SECRET_ACCESS_KEY=change-me-too
S3_FORCE_PATH_STYLE=true

# Optional: SMTP relay and AI provider (worker only; framework documents only, DEC-013)
SMTP_URL=
SMTP_FROM=
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
