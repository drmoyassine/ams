# All configuration is environment-only (DEC-008). Copy to .env for docker compose.
COMPOSE_FILE=compose.yaml:compose.local.yaml
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL 16+ (compose service "postgres")
POSTGRES_USER=ams
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ams
DATABASE_URL=postgres://ams:change-me@postgres:5432/ams

# Better Auth: random string, 32+ chars (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Seed administrator, created on first start when the database has no institution
INSTITUTION_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Generic OIDC single sign-on (set all three to enable). Redirect URI: ${APP_URL}/api/auth/callback/${OIDC_PROVIDER_ID}
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_ID=oidc

# S3-compatible storage (compose service "garage"; any S3 API works).
# Garage key format: id = GK + 24 hex chars, secret = 64 hex chars.
#   S3_ACCESS_KEY_ID=GK$(openssl rand -hex 12)   S3_SECRET_ACCESS_KEY=$(openssl rand -hex 32)
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=ams
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Garage cluster secrets (`openssl rand -hex 32` each)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# The app prepares Garage itself before it serves (layout, S3 key, bucket, grant) when this is set. compose.yaml sets it
# for the app service; set it in .env only when running the API outside Docker (then http://localhost:3903). Leave it
# unset on any other S3 host (AWS S3, MinIO ...): nothing is bootstrapped.
GARAGE_ADMIN_URL=
# Optional: how long the app waits for Garage to start (attempts x delay).
# GARAGE_BOOTSTRAP_ATTEMPTS=60
# GARAGE_BOOTSTRAP_DELAY_MS=2000

# Background services (worker, parser, agent) are three compose services with WORKER_QUEUES set there; the lists must
# match QUEUE_GROUPS in packages/shared (checked by a test). Unset = one process takes every job type (local dev, tests).
# WORKER_QUEUES=extract_text,analyse
# WORKER_NAME=dev

# Optional: SMTP relay and AI provider (used by the agent service; framework documents only, DEC-013)
SMTP_URL=
SMTP_FROM=
# Encrypts the AI account keys saved in Settings -> AI (32+ characters). Defaults to AUTH_SECRET when empty.
APP_SECRET=
# AI_PROVIDER: anthropic | openai | google | openrouter | openai_compatible. Used only when no account is assigned to analysis in Settings -> AI.
AI_PROVIDER=anthropic
AI_MODEL=
# The key for the provider chosen above (a key saved in Settings -> AI wins; keys are never used for another provider).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
# openai_compatible only (Ollama, vLLM, LM Studio, Azure ...): the server address, e.g. http://host:11434/v1.
# The key is optional there (a local Ollama needs none).
AI_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Publish the three Appendix A frameworks on first start. Needs the seed administrator above.
SEED_DEMO_FRAMEWORKS=false
